<?php

declare(strict_types=1);

/**
 * @file
 * Arabic version of the public site: language switch, hreflang, sitemap.
 */

use Drupal\Component\Utility\Html;
use Drupal\Core\Language\LanguageInterface;
use Drupal\Core\Menu\MenuLinkInterface;
use Drupal\Core\StringTranslation\TranslatableMarkup;
use Drupal\Core\Url;
use Drupal\bfep_i18n\LanguageSettings;

/**
 * Implements hook_rebuild().
 *
 * `bfep deploy` runs drush cr, so a changed .po file is loaded on deploy.
 */
function bfep_i18n_rebuild(): void {
  \Drupal::service('bfep_i18n.translations')->sync();
}

/**
 * Whether the current page is a public (non-admin) page.
 */
function _bfep_i18n_is_public_page(): bool {
  $route = \Drupal::routeMatch()->getRouteObject();
  if ($route === NULL || $route->getOption('_admin_route')) {
    return FALSE;
  }
  return !\Drupal::service('router.admin_context')->isAdminRoute($route);
}

/**
 * The site's languages with their URL path prefixes.
 *
 * @return array<string, array{language: \Drupal\Core\Language\LanguageInterface, prefix: string}>
 *   Keyed by langcode, in the site's language order.
 */
function _bfep_i18n_languages(): array {
  $prefixes = (array) \Drupal::config('language.negotiation')->get('url.prefixes');
  $languages = [];
  foreach (\Drupal::languageManager()->getLanguages() as $langcode => $language) {
    if (array_key_exists($langcode, $prefixes)) {
      $languages[$langcode] = ['language' => $language, 'prefix' => trim((string) $prefixes[$langcode], '/')];
    }
  }
  return $languages;
}

/**
 * The site's languages that everyone can see, as _bfep_i18n_languages().
 *
 * Staff-only and switched-off languages are left out of hreflang links, the
 * sitemap and Open Graph locales.
 *
 * @return array<string, array{language: \Drupal\Core\Language\LanguageInterface, prefix: string}>
 *   Keyed by langcode, in the site's language order.
 */
function _bfep_i18n_public_languages(): array {
  /** @var \Drupal\bfep_i18n\LanguageSettings $settings */
  $settings = \Drupal::service('bfep_i18n.language_settings');
  return array_filter(
    _bfep_i18n_languages(),
    static fn (string $langcode): bool => $settings->visibility($langcode) === LanguageSettings::PUBLIC,
    ARRAY_FILTER_USE_KEY,
  );
}

/**
 * The current page's path without its language prefix, and its query.
 *
 * Read from the main request, so error pages switch to the page that was
 * asked for rather than to /system/404.
 *
 * @return array{0: string, 1: array}
 *   The path (such as /campaigns/42) and the query arguments.
 */
function _bfep_i18n_current_path(): array {
  $request = \Drupal::requestStack()->getMainRequest();
  $path = $request?->getPathInfo() ?? '/';
  $first = explode('/', ltrim($path, '/'), 2);
  foreach (_bfep_i18n_languages() as $info) {
    if ($info['prefix'] !== '' && $first[0] === $info['prefix']) {
      $path = '/' . ($first[1] ?? '');
      break;
    }
  }
  if (\Drupal::service('path.matcher')->isFrontPage()) {
    $path = '/';
  }
  $query = $request?->query->all() ?? [];
  unset($query['lang']);
  return [$path, $query];
}

/**
 * A site-relative URL for a path in a language.
 */
function _bfep_i18n_url(string $path, string $prefix, array $query = []): string {
  $url = \Drupal::request()->getBasePath()
    . ($prefix !== '' ? '/' . $prefix . ($path === '/' ? '' : $path) : $path);
  return $query ? $url . '?' . http_build_query($query, '', '&', PHP_QUERY_RFC3986) : $url;
}

/**
 * Implements hook_preprocess_HOOK() for page.html.twig.
 *
 * Adds the language switch to the header of every public page. It offers
 * the languages the visitor can see, and is left out when the Languages
 * settings turn it off.
 */
function bfep_i18n_preprocess_page(array &$variables): void {
  if (!_bfep_i18n_is_public_page()) {
    return;
  }
  /** @var \Drupal\bfep_i18n\LanguageSettings $settings */
  $settings = \Drupal::service('bfep_i18n.language_settings');
  $account = \Drupal::currentUser();
  $languages = array_filter(
    _bfep_i18n_languages(),
    static fn (string $langcode): bool => $settings->canSee($langcode, $account),
    ARRAY_FILTER_USE_KEY,
  );
  // The page changes when the settings or the visitor's permissions do.
  $cache = [
    'contexts' => ['url.path', 'url.query_args', 'url.path.is_front', 'languages:language_interface', 'user.permissions'],
    'tags' => ['config:bfep_i18n.settings'],
  ];
  if (!$settings->showSwitch() || count($languages) < 2) {
    $variables['page']['header']['bfep_i18n_language_switch'] = ['#cache' => $cache];
    return;
  }
  $current = \Drupal::languageManager()->getCurrentLanguage(LanguageInterface::TYPE_INTERFACE)->getId();
  [$path, $query] = _bfep_i18n_current_path();

  // Short labels, each written in its own language.
  $labels = ['en' => 'EN', 'ar' => 'عربي'];
  $options = [];
  foreach ($languages as $langcode => $info) {
    $options[] = [
      'langcode' => $langcode,
      'label' => $labels[$langcode] ?? strtoupper($langcode),
      'name' => $info['language']->getName() === 'Arabic' ? 'العربية' : ($langcode === 'en' ? 'English' : $info['language']->getName()),
      // LanguageRedirect stores ?lang= as the visitor's choice. Without it
      // the link still leads to the page in that language.
      'url' => _bfep_i18n_url($path, $info['prefix'], [...$query, 'lang' => $langcode]),
      'active' => $langcode === $current,
      'direction' => $info['language']->getDirection(),
    ];
  }

  $variables['page']['header']['bfep_i18n_language_switch'] = [
    '#theme' => 'bfep_language_switch',
    '#options' => $options,
    '#current' => $current,
    '#weight' => 100,
    '#attached' => ['library' => ['bfep_i18n/language-switcher']],
    '#cache' => $cache,
  ];
}

/**
 * Translates text staff built on the site, such as a footer menu link.
 *
 * Menu links, block titles and custom block text are typed in on the site in
 * English, so they have no Arabic of their own. On a page in another
 * language they are looked up under User interface translation instead, with
 * a context that says where they come from, then without one. Looking them
 * up also lists them there, so staff can find and translate them.
 *
 * @param string $text
 *   The English text.
 * @param string $context
 *   'Site menu link', 'Site block title' or 'Site block text'.
 *
 * @return string|null
 *   The translation, or NULL when there is none (or the page is in the
 *   default language, or the text is already in the page's language).
 */
function _bfep_i18n_site_text(string $text, string $context): ?string {
  $language = \Drupal::languageManager()->getCurrentLanguage();
  if ($language->isDefault() || trim($text) === '' || !_bfep_i18n_is_public_page()) {
    return NULL;
  }
  // Already translated, for example with Configuration translation.
  if ($language->getId() === 'ar' && preg_match('/\p{Arabic}/u', $text)) {
    return NULL;
  }
  // phpcs:ignore Drupal.Semantics.FunctionT.NotLiteralString
  $translated = (string) new TranslatableMarkup($text, [], ['context' => $context, 'langcode' => $language->getId()]);
  if ($translated !== $text) {
    return $translated;
  }
  // The same English used elsewhere on the site, such as "Campaigns" or a
  // sentence of the original policy pages, already has a translation.
  $string = \Drupal::service('locale.storage')->findTranslation(['source' => $text, 'context' => '', 'language' => $language->getId()]);
  $fallback = $string?->isTranslation() ? (string) $string->getString() : '';
  return $fallback !== '' && $fallback !== $text ? $fallback : NULL;
}

/**
 * Implements hook_preprocess_HOOK() for menu.
 *
 * Menu links staff added on the site (footer links, for example).
 */
function bfep_i18n_preprocess_menu(array &$variables): void {
  _bfep_i18n_translate_menu_items($variables['items']);
}

/**
 * Translates the titles of site-built menu links, at every depth.
 */
function _bfep_i18n_translate_menu_items(array &$items): void {
  foreach ($items as &$item) {
    $link = $item['original_link'] ?? NULL;
    if ($link instanceof MenuLinkInterface && $link->getProvider() === 'menu_link_content' && is_string($title = (string) ($item['title'] ?? ''))) {
      $translated = _bfep_i18n_site_text($title, 'Site menu link');
      if ($translated !== NULL) {
        $item['title'] = $translated;
      }
    }
    if (!empty($item['below'])) {
      _bfep_i18n_translate_menu_items($item['below']);
    }
  }
}

/**
 * Implements hook_preprocess_HOOK() for block.
 *
 * Block titles, and the body of custom blocks, typed in on the site.
 */
function bfep_i18n_preprocess_block(array &$variables): void {
  if (is_string($variables['label'] ?? NULL) || $variables['label'] instanceof \Stringable) {
    $translated = _bfep_i18n_site_text((string) $variables['label'], 'Site block title');
    if ($translated !== NULL) {
      $variables['label'] = $translated;
    }
  }
  if (str_starts_with((string) ($variables['plugin_id'] ?? ''), 'block_content:') && isset($variables['content']['body'])) {
    foreach ($variables['content']['body'] as $delta => &$item) {
      // Formatted text is translated before its text format filters it.
      if (is_int($delta) && is_array($item) && is_string($item['#text'] ?? NULL)) {
        $item['#text'] = _bfep_i18n_translate_html($item['#text'], 'Site block text');
      }
    }
  }
}

/**
 * Translates HTML staff wrote on the site one piece of text at a time.
 *
 * Each paragraph, heading, list item or link text is looked up on its own, so
 * the HTML around it stays as staff wrote it and an edit to one paragraph
 * only needs that paragraph translated again. Links to pages on this site
 * are pointed at the same page in the current language.
 *
 * @param string $html
 *   The English HTML.
 * @param string $context
 *   The translation context, such as 'Site block text' or 'Policy text'.
 * @param int $missing
 *   Set to the number of pieces of text that have no translation. Each is
 *   marked as English.
 */
function _bfep_i18n_translate_html(string $html, string $context, int &$missing = 0): string {
  $missing = 0;
  $language = \Drupal::languageManager()->getCurrentLanguage();
  if ($language->isDefault() || !_bfep_i18n_is_public_page()) {
    return $html;
  }
  $prefix = _bfep_i18n_languages()[$language->getId()]['prefix'] ?? '';
  $document = Html::load($html);
  $xpath = new \DOMXPath($document);
  $changed = FALSE;
  foreach ($xpath->query('//body//text()[normalize-space()]') as $node) {
    $text = $node->nodeValue;
    $translated = _bfep_i18n_site_text(trim($text), $context);
    if ($translated === NULL) {
      $missing++;
      // Screen readers and browsers should read it as English.
      $parent = $node->parentNode;
      if ($parent instanceof \DOMElement && $parent->nodeName !== 'body' && !$parent->hasAttribute('lang')) {
        $parent->setAttribute('lang', 'en');
        $parent->setAttribute('dir', 'ltr');
        $changed = TRUE;
      }
    }
    else {
      // Keep the spaces around the text, which separate it from its
      // neighbours.
      preg_match('/^\s*/u', $text, $before);
      preg_match('/\s*$/u', $text, $after);
      $node->nodeValue = $before[0] . $translated . $after[0];
      $changed = TRUE;
    }
  }
  if ($prefix !== '') {
    foreach ($xpath->query('//body//a[starts-with(@href, "/")]') as $link) {
      $href = $link->getAttribute('href');
      if (str_starts_with($href, '//') || $href === '/' . $prefix || str_starts_with($href, '/' . $prefix . '/') || preg_match('#^/(admin|user|sites|system|core)(/|$)#', $href)) {
        continue;
      }
      $link->setAttribute('href', '/' . $prefix . ($href === '/' ? '' : $href));
      $changed = TRUE;
    }
  }
  return $changed ? Html::serialize($document) : $html;
}

/**
 * Implements hook_theme().
 */
function bfep_i18n_theme(): array {
  return [
    'bfep_language_switch' => [
      'variables' => ['options' => [], 'current' => ''],
    ],
  ];
}

/**
 * Implements hook_page_attachments().
 *
 * Adds the right-to-left styles to Arabic pages, and links each public page
 * to its versions in the other languages, so search engines show people the
 * version in their language.
 */
function bfep_i18n_page_attachments(array &$attachments): void {
  $attachments['#cache']['contexts'][] = 'languages:language_interface';
  $attachments['#cache']['contexts'][] = 'user.permissions';
  $attachments['#cache']['tags'][] = 'config:bfep_i18n.settings';
  $language = \Drupal::languageManager()->getCurrentLanguage();
  if ($language->getDirection() === LanguageInterface::DIRECTION_RTL && _bfep_i18n_is_public_page()) {
    // The Arabic typeface and the few theme fixes right-to-left pages need.
    $attachments['#attached']['library'][] = 'bfep_i18n/right-to-left';
  }

  $seo = \Drupal::service('bfep.seo_manager')->context();
  if ($seo === NULL || !isset($seo['path'])) {
    return;
  }
  /** @var \Drupal\bfep\Service\BfepSettings $settings */
  $settings = \Drupal::service('bfep.settings');
  $languages = _bfep_i18n_public_languages();
  if (count($languages) < 2) {
    return;
  }
  $default = \Drupal::languageManager()->getDefaultLanguage()->getId();
  $links = [];
  foreach (array_keys($languages) as $langcode) {
    $links[$langcode] = $settings->localizedUrl($seo['path'], $langcode);
  }
  $links['x-default'] = $links[$default] ?? $settings->absoluteUrl($seo['path']);
  foreach ($links as $hreflang => $href) {
    $attachments['#attached']['html_head_link'][] = [[
      'rel' => 'alternate',
      'hreflang' => $hreflang,
      'href' => $href,
    ], FALSE,
    ];
  }
}

/**
 * Implements hook_page_top().
 *
 * Reminds staff when the page they are looking at is in a language the
 * public cannot see yet.
 */
function bfep_i18n_page_top(array &$page_top): void {
  $cache = [
    'contexts' => ['languages:language_interface', 'user.permissions'],
    'tags' => ['config:bfep_i18n.settings'],
  ];
  $page_top['bfep_i18n_preview'] = ['#cache' => $cache];
  $language = \Drupal::languageManager()->getCurrentLanguage();
  /** @var \Drupal\bfep_i18n\LanguageSettings $settings */
  $settings = \Drupal::service('bfep_i18n.language_settings');
  if ($settings->visibility($language->getId()) === LanguageSettings::PUBLIC || !_bfep_i18n_is_public_page()) {
    return;
  }
  $message = t('Staff preview: only signed-in staff can see the @language pages.', ['@language' => $language->getName()]);
  if (\Drupal::currentUser()->hasPermission('administer bfep languages')) {
    $message = t('Staff preview: only signed-in staff can see the @language pages. <a href=":url">Change this in Languages</a>.', [
      '@language' => $language->getName(),
      // Staff pages are English.
      ':url' => Url::fromRoute('bfep_i18n.settings', [], ['language' => \Drupal::languageManager()->getDefaultLanguage()])->toString(),
    ]);
  }
  $page_top['bfep_i18n_preview'] += [
    '#type' => 'html_tag',
    '#tag' => 'div',
    '#attributes' => ['class' => ['bfep-i18n-preview'], 'role' => 'note', 'lang' => 'en', 'dir' => 'ltr'],
    'message' => ['#markup' => $message],
    '#attached' => ['library' => ['bfep_i18n/preview']],
  ];
}

/**
 * Implements hook_metatags_alter().
 *
 * Runs after bfep_metatags_alter(), which sets the English locale.
 */
function bfep_i18n_metatags_alter(array &$metatags, array &$context): void {
  if (\Drupal::service('bfep.seo_manager')->context() === NULL) {
    return;
  }
  $locales = ['en' => 'en_NZ', 'ar' => 'ar_AR'];
  $current = \Drupal::languageManager()->getCurrentLanguage()->getId();
  $metatags['og_locale'] = $locales[$current] ?? $current;
  $alternates = array_values(array_diff_key(
    array_intersect_key($locales, _bfep_i18n_public_languages()),
    [$current => TRUE],
  ));
  if ($alternates) {
    $metatags['og_locale_alternative'] = implode(',', $alternates);
  }
}

/**
 * Implements hook_simple_sitemap_arbitrary_links_alter().
 *
 * Runs after bfep's, which adds the English URLs. Each gets its Arabic
 * version, and both list the other as an alternate.
 */
function bfep_i18n_simple_sitemap_arbitrary_links_alter(array &$arbitrary_links, $sitemap): void {
  if ($sitemap->id() !== 'default') {
    return;
  }
  /** @var \Drupal\bfep\Service\BfepSettings $settings */
  $settings = \Drupal::service('bfep.settings');
  $languages = array_keys(_bfep_i18n_public_languages());
  if (count($languages) < 2) {
    return;
  }
  $base = $settings->baseUrl();
  $links = [];
  foreach ($arbitrary_links as $link) {
    $url = (string) ($link['url'] ?? '');
    if (!str_starts_with($url, $base . '/')) {
      $links[] = $link;
      continue;
    }
    $path = substr($url, strlen($base)) ?: '/';
    $alternates = [];
    foreach ($languages as $langcode) {
      $alternates[$langcode] = $settings->localizedUrl($path, $langcode);
    }
    foreach ($alternates as $localized) {
      $links[] = ['url' => $localized, 'alternate_urls' => $alternates] + $link;
    }
  }
  $arbitrary_links = $links;
}

/**
 * Implements hook_config_translation_info_alter().
 */
function bfep_i18n_config_translation_info_alter(array &$info): void {
  // The content settings form only exists while bfep_content is enabled.
  if (!\Drupal::moduleHandler()->moduleExists('bfep_content')) {
    unset($info['bfep_i18n.bfep_content_settings']);
  }
}

/**
 * Implements hook_preprocess_HOOK() for bfep_trust_page.html.twig.
 *
 * Runs after bfep_content's preprocess, which loads the edited policy text.
 * Text that has no translation yet is shown in English, marked as English so
 * it reads left to right and screen readers pronounce it correctly.
 */
function bfep_i18n_preprocess_bfep_trust_page(array &$variables): void {
  $langcode = \Drupal::languageManager()->getCurrentLanguage()->getId();
  if ($langcode === 'en' || !\Drupal::moduleHandler()->moduleExists('bfep_content')) {
    return;
  }
  $page = (string) (\Drupal::routeMatch()->getRouteObject()?->getDefault('page') ?? '');
  if ($page === '') {
    return;
  }
  /** @var \Drupal\language\ConfigurableLanguageManagerInterface $manager */
  $manager = \Drupal::languageManager();
  $override = $manager->getLanguageConfigOverride($langcode, 'bfep_content.settings');
  $english = ['lang' => 'en', 'dir' => 'ltr'];
  if (is_string($variables['body']['#text'] ?? NULL) && trim((string) $override->get('policies.' . $page . '.body.value')) === '') {
    // No translation of the whole page, which happens once staff edit the
    // English: translate it a paragraph at a time from User interface
    // translation instead (context 'Policy text'). Paragraphs with no
    // translation are marked as English.
    $variables['body']['#text'] = _bfep_i18n_translate_html($variables['body']['#text'], 'Policy text');
  }
  if (($variables['intro'] ?? '') !== '' && trim((string) $override->get('policies.' . $page . '.intro')) === '') {
    $variables['intro_attributes'] = $english;
  }
}

/**
 * Implements hook_preprocess_HOOK() for bfep_staff_guide.html.twig.
 */
function bfep_i18n_preprocess_bfep_staff_guide(array &$variables): void {
  $variables['extra_tips'][] = [
    '#markup' => t('The public site also has an Arabic version, under /ar. A site administrator sets who can see it on the Languages tab. Campaign names, descriptions and other details you enter are shown as you typed them in both languages. To change the Arabic for a label or sentence, use <a href=":interface">User interface translation</a>. For the headline, page titles, policy pages and the Instagram message, use the Translate tab on <a href=":content">Content and channels</a> or <a href=":settings">BFEP settings</a>. If a page is refused, ask a site administrator.', [
      ':interface' => Url::fromRoute('locale.translate_page')->toString(),
      ':content' => Url::fromRoute(\Drupal::moduleHandler()->moduleExists('bfep_content') ? 'config_translation.item.overview.bfep_content.settings' : 'config_translation.item.overview.bfep.settings')->toString(),
      ':settings' => Url::fromRoute('config_translation.item.overview.bfep.settings')->toString(),
    ]),
  ];
}

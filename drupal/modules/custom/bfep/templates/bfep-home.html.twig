<div class="bfep-page bfep-home">
  <section class="bfep-hero" aria-labelledby="bfep-home-title">
    <div class="bfep-hero-card">
      <p class="bfep-eyebrow">{{ organization }}</p>
      <h1 id="bfep-home-title">{{ tagline }}</h1>
      <p class="bfep-lead">{% trans %}Discover humanitarian fundraisers, check the information available, submit a referral, or help keep the directory current.{% endtrans %}</p>
      <div class="bfep-actions">
        <a class="button button--primary" href="{{ links.campaigns }}">{% trans %}View campaigns{% endtrans %}</a>
        <a class="button" href="{{ links.countries }}">{% trans %}Browse countries{% endtrans %}</a>
        <a class="button" href="{{ links.refer }}">{% trans %}Submit a referral{% endtrans %}</a>
      </div>
    </div>
  </section>

  <section aria-labelledby="bfep-directory-heading">
    <h2 id="bfep-directory-heading" class="visually-hidden">{% trans %}Directory at a glance{% endtrans %}</h2>
    <div class="bfep-stats-row">
      <div class="bfep-stat-card"><strong class="bfep-stat-number">{{ stats.total_campaigns|default(0) }}</strong><span class="bfep-stat-label">{% trans %}Campaigns listed{% endtrans %}</span></div>
      <div class="bfep-stat-card"><strong class="bfep-stat-number">{{ stats.featured_campaigns|default(0) }}</strong><span class="bfep-stat-label">{% trans %}Featured by BFEP{% endtrans %}</span></div>
      <div class="bfep-stat-card"><strong class="bfep-stat-number">{{ stats.urgent_campaigns|default(0) }}</strong><span class="bfep-stat-label">{% trans %}Urgent medical cases{% endtrans %}</span></div>
      <div class="bfep-stat-card"><strong class="bfep-stat-number">{{ stats.countries|default(0) }}</strong><span class="bfep-stat-label">{% trans %}Countries represented{% endtrans %}</span></div>
    </div>
  </section>

  {% if spotlight %}
    <section class="bfep-spotlight" aria-labelledby="bfep-spotlight-heading">
      <h2 id="bfep-spotlight-heading">{% trans %}Campaigns that need help now{% endtrans %}</h2>
      <p class="bfep-spotlight__intro">{% trans %}Urgent medical cases first, then the campaigns furthest from their goal.{% endtrans %}</p>
      <div class="bfep-campaign-grid">
        {% for item in spotlight %}
          <article class="bfep-campaign-card bfep-campaign-card--compact">
            <div class="bfep-card-heading">
              <h3><a class="bfep-campaign-title" href="{{ item.detail_url }}">{{ item.name }}</a></h3>
              {% if item.line_number %}<span class="bfep-line">{% trans %}Line #{{ item.line_number }}{% endtrans %}</span>{% endif %}
            </div>
            {% if item.badges %}<ul class="bfep-badges" aria-label="{% trans %}Campaign details{% endtrans %}">{% for badge in item.badges %}<li>{{ badge }}</li>{% endfor %}</ul>{% endif %}
            {% if item.amounts %}<dl class="bfep-amounts">{% for amount in item.amounts %}<div><dt>{{ amount.label }}</dt><dd>{{ amount.value }}</dd></div>{% endfor %}</dl>{% endif %}
            {% if item.progress is not null %}<progress class="bfep-progress" max="100" value="{{ item.progress }}" aria-label="{% trans %}Funding progress{% endtrans %}">{{ item.progress }}%</progress>{% endif %}
            <div class="bfep-card-actions"><a class="button" href="{{ item.detail_url }}">{% trans %}View details{% endtrans %}<span class="visually-hidden">: {{ item.name }}</span></a></div>
          </article>
        {% endfor %}
      </div>
      <p class="bfep-related-more"><a href="{{ links.least_funded }}">{% trans %}See all campaigns, least funded first{% endtrans %}</a></p>
    </section>
  {% endif %}

  <section class="bfep-home-grid" aria-labelledby="bfep-help-heading">
    <h2 id="bfep-help-heading">{% trans %}Find a way to help{% endtrans %}</h2>
    <div class="bfep-campaign-grid">
      <article class="bfep-campaign-card">
        <h3><a href="{{ links.campaigns }}">{% trans %}Find campaigns{% endtrans %}</a></h3>
        <p>{% trans %}Search by name, country, urgency, platform, or tag.{% endtrans %}</p>
      </article>
      <article class="bfep-campaign-card">
        <h3><a href="{{ links.verify }}">{% trans %}Understand verification{% endtrans %}</a></h3>
        <p>{% trans %}See what the review process checks—and what no remote review can guarantee.{% endtrans %}</p>
      </article>
      <article class="bfep-campaign-card">
        <h3><a href="{{ links.change }}">{% trans %}Correct a record{% endtrans %}</a></h3>
        <p>{% trans %}Tell the team about changed, inaccurate, unsafe, or private information.{% endtrans %}</p>
      </article>
      <article class="bfep-campaign-card">
        <h3><a href="{{ links.volunteer }}">{% trans %}Volunteer{% endtrans %}</a></h3>
        <p>{% trans %}Help research, organise, translate, and maintain campaign information.{% endtrans %}</p>
      </article>
    </div>
  </section>

  <aside class="bfep-trust-callout" aria-labelledby="bfep-trust-heading">
    <div>
      <p class="bfep-eyebrow">{% trans %}Before you donate{% endtrans %}</p>
      <h2 id="bfep-trust-heading">{% trans %}A directory reduces friction, not every risk.{% endtrans %}</h2>
      <p>{% trans %}BFEP does not process donations. Review the current fundraiser and use its platform’s protected payment flow.{% endtrans %}</p>
    </div>
    <div class="bfep-actions">
      <a class="button" href="{{ links.transparency }}">{% trans %}Read our transparency page{% endtrans %}</a>
      <a class="button" href="{{ links.about }}">{% trans %}About the project{% endtrans %}</a>
    </div>
  </aside>
</div>

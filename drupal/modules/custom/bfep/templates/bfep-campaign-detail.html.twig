<article class="bfep-page bfep-detail">
  {% if campaign.metadata %}
    <dl class="bfep-detail-meta">
      {% for item in campaign.metadata %}<div><dt>{{ item.label }}</dt><dd>{{ item.value }}</dd></div>{% endfor %}
    </dl>
  {% endif %}
  {% if campaign.amounts %}
    <dl class="bfep-detail-meta bfep-detail-meta--amounts">
      {% for amount in campaign.amounts %}<div><dt>{{ amount.label }}</dt><dd>{{ amount.value }}</dd></div>{% endfor %}
    </dl>
  {% endif %}
  {% if campaign.progress is not null %}<progress class="bfep-progress" max="100" value="{{ campaign.progress }}" aria-label="{% trans %}Funding progress{% endtrans %}">{{ campaign.progress }}%</progress>{% endif %}
  {% if campaign.tags %}<ul class="bfep-tags" aria-label="{% trans %}Tags{% endtrans %}">{% for tag in campaign.tags %}<li class="bfep-tag">{{ tag }}</li>{% endfor %}</ul>{% endif %}

  <section class="bfep-description" aria-labelledby="bfep-description-heading">
    <h2 id="bfep-description-heading">{% trans %}About this campaign{% endtrans %}</h2>
    {% if campaign.paragraphs %}{% for paragraph in campaign.paragraphs %}<p>{{ paragraph }}</p>{% endfor %}{% else %}<p class="bfep-muted">{% trans %}No public description is currently available.{% endtrans %}</p>{% endif %}
  </section>

  {% if campaign.updated %}<p class="bfep-updated">{% trans %}Directory record last updated {{ campaign.updated }}.{% endtrans %}</p>{% endif %}
  <p class="bfep-disclaimer">{% trans %}BFEP marks a campaign as verified only while it maintains direct contact with the beneficiary and the beneficiary confirms that they are receiving funds from the fundraiser organiser. BFEP does not process donations, and verification is not a financial guarantee.{% endtrans %} <a href="{{ verification_url }}">{% trans %}How verification works{% endtrans %}</a>.</p>

  <div class="bfep-actions">
    {% if campaign.fundraiser_url %}<a class="button button--primary" href="{{ campaign.fundraiser_url }}" target="_blank" rel="ugc nofollow noopener noreferrer">{% trans %}Open fundraiser{% endtrans %}<span class="visually-hidden"> {% trans %}(opens in a new tab){% endtrans %}</span></a>{% endif %}
    <a class="button" href="{{ change_url }}">{% trans %}Request an update{% endtrans %}</a>
    <a class="button" href="{{ campaigns_url }}">{% trans %}Back to campaigns{% endtrans %}</a>
  </div>

  {% if related %}
    <section class="bfep-related" aria-labelledby="bfep-related-heading">
      <h2 id="bfep-related-heading">{% trans %}More campaigns in {{ campaign.country }}{% endtrans %}</h2>
      <div class="bfep-campaign-grid">
        {% for item in related %}
          <article class="bfep-campaign-card bfep-campaign-card--compact">
            <div class="bfep-card-heading">
              <h3><a class="bfep-campaign-title" href="{{ item.detail_url }}">{{ item.name }}</a></h3>
              {% if item.line_number %}<span class="bfep-line">{% trans %}Line #{{ item.line_number }}{% endtrans %}</span>{% endif %}
            </div>
            {% if item.badges %}<ul class="bfep-badges" aria-label="{% trans %}Campaign details{% endtrans %}">{% for badge in item.badges %}<li>{{ badge }}</li>{% endfor %}</ul>{% endif %}
            {% if item.amounts %}<dl class="bfep-amounts">{% for amount in item.amounts %}<div><dt>{{ amount.label }}</dt><dd>{{ amount.value }}</dd></div>{% endfor %}</dl>{% endif %}
            {% if item.progress is not null %}<progress class="bfep-progress" max="100" value="{{ item.progress }}" aria-label="{% trans %}Funding progress{% endtrans %}">{{ item.progress }}%</progress>{% endif %}
            <div class="bfep-card-actions"><a class="button" href="{{ item.detail_url }}">{% trans %}View details{% endtrans %}<span class="visually-hidden">: {{ item.name }}</span></a></div>
          </article>
        {% endfor %}
      </div>
      {% if country_url %}<p class="bfep-related-more"><a href="{{ country_url }}">{% trans %}See all campaigns in {{ campaign.country }}{% endtrans %}</a></p>{% endif %}
    </section>
  {% endif %}
</article>

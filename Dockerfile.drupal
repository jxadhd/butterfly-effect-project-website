FROM drupal@sha256:d059fada2d2f9ebfcde8f8d3208007946d1ee843ee2dd9ed00b15ead0c282def

RUN apt-get update \
    && apt-get install -y --no-install-recommends libgmp-dev \
    && docker-php-ext-configure gmp \
    && docker-php-ext-install -j"$(nproc)" gmp \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/drupal

RUN composer require \
      "drupal/honeypot:^2.2" \
      "drupal/metatag:^2.2" \
      "drupal/simple_sitemap:^4.2.3" \
      "drupal/oidc:^2.3.0" \
      "drush/drush:^13.7.6" \
      --with-all-dependencies \
      --no-interaction \
      --no-progress \
      --prefer-dist \
      --update-no-dev \
      --optimize-autoloader \
    && composer clear-cache

# The base image's opcache-recommended.ini caches at most 4000 files, but
# Drupal core plus vendor has well over that, so scripts keep getting evicted
# and recompiled and uncached pages render slowly. zz- sorts after it, so
# these values win.
RUN printf '%s\n' \
      'opcache.memory_consumption=256' \
      'opcache.interned_strings_buffer=32' \
      'opcache.max_accelerated_files=30000' \
      > /usr/local/etc/php/conf.d/zz-bfep-opcache.ini

RUN printf '%s\n' 'ServerName butterfly.joshcross.co.nz' \
      > /etc/apache2/conf-available/servername.conf \
    && a2enconf servername

RUN printf '\nSitemap: https://butterfly.joshcross.co.nz/sitemap.xml\n' >> /opt/drupal/web/robots.txt

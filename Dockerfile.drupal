FROM drupal@sha256:1ac414c513e88f39d3857eaed661850c1fb79146ca2707e9c30a5ce424520576

RUN apt-get update \
    && apt-get install -y --no-install-recommends libgmp-dev \
    && docker-php-ext-configure gmp \
    && docker-php-ext-install -j"$(nproc)" gmp \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/drupal

RUN composer require \
      "drupal/honeypot:^2.2" \
      "drupal/metatag:^2.2" \
      "drupal/simple_sitemap:^4.2.3" \
      "drupal/oidc:^2.3.0" \
      "drush/drush:^13.7.6" \
      --with-all-dependencies \
      --no-interaction \
      --no-progress \
      --prefer-dist \
      --update-no-dev \
      --optimize-autoloader \
    && composer clear-cache

# The base image's opcache-recommended.ini caches at most 4000 files, but
# Drupal core plus vendor has well over that, so scripts keep getting evicted
# and recompiled and uncached pages render slowly. zz- sorts after it, so
# these values win.
RUN printf '%s\n' \
      'opcache.memory_consumption=256' \
      'opcache.interned_strings_buffer=32' \
      'opcache.max_accelerated_files=30000' \
      > /usr/local/etc/php/conf.d/zz-bfep-opcache.ini

# PHP's defaults (8 MB per request, 2 MB per file) are too small for photo
# uploads from phones; the admin forms shrink photos in the browser first,
# but a browser without JavaScript sends them as taken. 256 MB of memory
# lets GD resize a 40-megapixel photo.
RUN printf '%s\n' \
      'upload_max_filesize=20M' \
      'post_max_size=90M' \
      'max_file_uploads=30' \
      'memory_limit=256M' \
      > /usr/local/etc/php/conf.d/zz-bfep-uploads.ini

RUN printf '%s\n' 'ServerName bfep.org' \
      > /etc/apache2/conf-available/servername.conf \
    && a2enconf servername

RUN printf '\nSitemap: https://bfep.org/sitemap.xml\n' >> /opt/drupal/web/robots.txt
